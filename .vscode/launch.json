{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch SPARTA (Debug)",
            "type": "cppdbg",
            "request": "launch",
            // 【重要】ビルドされた実行ファイルのパスを指定
            // ※ CMakeの設定によっては "build/src/spa_plain" かもしれません。確認してください。
            "program": "${workspaceFolder}/src/spa_plain",
            
            // 【重要】実行時の引数（インプットスクリプト等）
            // ここでは bench フォルダのテスト用スクリプトを指定する例です
            "args": [
                "-in", "in.lj" 
            ],
            
            "stopAtEntry": false,
            
            // 【重要】実行時のカレントディレクトリ（インプットファイルがある場所）
            "cwd": "${workspaceFolder}/bench",
            
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "gdb の pretty-printing を有効にする",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}