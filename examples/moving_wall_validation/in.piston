# specular piston moving at U = 100 m/s into a collisionless gas at rest
# checks normal momentum transfer of the moving wall:
#   time-averaged piston pressure vs free-molecular value
#   p/p0 = (1+2s^2)(1+erf s) + 2s/sqrt(pi) exp(-s^2), s = U/c_mp
#   valid until molecules reflected by the piston return from x = 10
# usage: mpirun -np 4 spa_mpi -in in.piston -var engulf delete|project \
#          -var wallvel yes|no [-var dx 0.0]

seed                12345
dimension           2
global              gridcut 0.0 comm/sort yes

boundary            r r p

create_box          0 10 0 1 -0.5 0.5
create_grid         200 20 1
balance_grid        rcb cell

global              nrho 1.0e18 fnum 5.0e13

species             air.species N
mixture             gas N vstream 0.0 0.0 0.0 temp 300.0

read_surf           data.piston

surf_collide        1 specular
surf_modify         all collide 1

timestep            2.0e-5

create_particles    gas n 0

# piston moves dx in 400 steps, dx = 0.8 is 100 m/s
# dx = 0.0 is a static wall, calibration of p0 (-var dx 0.0)

variable            dx index 0.8

fix                 10 move/surf all 1 400 trans ${dx} 0 0 &
                    engulf ${engulf} wallvel ${wallvel}

compute             1 surf all gas press
fix                 2 ave/surf all 1 400 400 c_1[1]
compute             3 reduce ave f_2

stats               400
stats_style         step np nscoll f_10 c_3

run                 400
