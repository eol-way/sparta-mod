# specular piston moving at U = 100 m/s into a collisionless gas at rest
# checks normal momentum transfer of the moving wall:
#   time-averaged piston pressure vs free-molecular value
#   p/p0 = (1+2s^2)(1+erf s) + 2s/sqrt(pi) exp(-s^2), s = U/c_mp
#   valid until molecules reflected by the piston return from x = 10
#   dx < 0 is a receding piston (s < 0), the same formula holds
# usage: mpirun -np 4 spa_mpi -in in.piston -var engulf delete|project \
#          -var wallvel yes|no [-var dx 0.0] [-var nevery N -var nrun M]
# startup check: -var nevery 20 -var nrun 40 -var fnum 1.0e13 averages the
#   first 40 steps only, the wall velocity must be right from step 1

seed                12345
dimension           2
global              gridcut 0.0 comm/sort yes

boundary            r r p

create_box          0 10 0 1 -0.5 0.5
create_grid         200 20 1
balance_grid        rcb cell

variable            dx index 0.8
variable            nevery index 1
variable            nrun index 400
variable            fnum index 5.0e13

global              nrho 1.0e18 fnum ${fnum}

species             air.species N
mixture             gas N vstream 0.0 0.0 0.0 temp 300.0

read_surf           data.piston

surf_collide        1 specular
surf_modify         all collide 1

timestep            2.0e-5

create_particles    gas n 0

# piston moves dx in 400 steps, dx = 0.8 is 100 m/s
# dx = 0.0 is a static wall, calibration of p0 (-var dx 0.0)
# dx = -0.8 recedes at 100 m/s (-var dx -0.8)

fix                 10 move/surf all ${nevery} 400 trans ${dx} 0 0 &
                    engulf ${engulf} wallvel ${wallvel}

compute             1 surf all gas press
fix                 2 ave/surf all 1 ${nrun} ${nrun} c_1[1]
compute             3 reduce ave f_2

stats               ${nrun}
stats_style         step np nscoll f_10 c_3

# animation output for make_gifs.py (generate_all_gifs.sh), off by default
# -var anim N dumps every N steps: particle sample and surf shape

variable            anim index 0
# particle IDs are uniform in 1..2^31, id < 2^31/10 keeps a fixed 10% sample
if                  "${anim} > 0" then &
                    "dump a1 particle all ${anim} anim.piston.${engulf}_${wallvel}.particle.*.txt id x y" &
                    "dump_modify a1 thresh id < 214748365" &
                    "dump_modify a1 format float %20.15g" &
                    "dump a2 surf all ${anim} anim.piston.${engulf}_${wallvel}.surf.*.txt id v1x v1y v2x v2y" &
                    "dump_modify a2 format float %20.15g"

run                 ${nrun}
