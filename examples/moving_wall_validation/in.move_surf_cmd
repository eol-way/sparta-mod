# move_surf command (instantaneous move) with engulf delete vs project
# checks: no deleted particle (project), no particle inside the moved surf
# usage: mpirun -np 4 spa_mpi -in in.move_surf_cmd -var mode delete|project

seed                12345
dimension           2
global              gridcut 0.0 comm/sort yes

boundary            r r p

create_box          0 10 0 10 -0.5 0.5
create_grid         40 40 1
balance_grid        rcb cell

global              nrho 1.0 fnum 0.001

species             air.species N O
mixture             air N O vstream 0.0 0.0 0.0 temp 300.0

read_surf           data.circle origin 5 5 0 scale 0.2 1.2 1

surf_collide        1 diffuse 300.0 1.0
surf_modify         all collide 1

collide             vss air air.vss

timestep            0.0001

create_particles    air n 100000

stats               10
stats_style         step np nscoll

run                 10

move_surf           all trans 1.0 0 0 engulf ${mode}

dump                2 particle all 1 dump.move_surf_cmd.${mode}.*.txt id x y
dump_modify         2 format float %20.15g
run                 0
undump              2

run                 20
