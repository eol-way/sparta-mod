# 3d ellipsoid (tri surf) rotating in a closed box, engulf delete vs project
# checks: particle count conserved (project), no particle inside the surf
# usage: mpirun -np 4 spa_mpi -in in.ellipsoid3d -var mode delete|project

seed                12345
dimension           3
global              gridcut 0.1 comm/sort yes

boundary            r r r

create_box          -2 2 -2 2 -2 2
create_grid         20 20 20
balance_grid        rcb cell

global              nrho 1.0 fnum 0.002

species             air.species N O
mixture             air N O vstream 0.0 0.0 0.0 temp 300.0

read_surf           data.sphere scale 1.5 0.5 0.8

surf_collide        1 diffuse 300.0 1.0
surf_modify         all collide 1

collide             vss air air.vss

timestep            0.0001

create_particles    air n 32000

fix                 10 move/surf all 1 2000 rotate 360 0 0 1 0 0 0 engulf ${mode}

stats               100
stats_style         step cpu np nscoll f_10

dump                1 particle all 250 dump.ellipsoid3d.${mode}.*.txt id x y z
dump_modify         1 format float %20.15g

run                 500
