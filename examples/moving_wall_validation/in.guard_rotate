# safety guard: surf_collide diffuse with the rotate keyword on moving surfs
#   wallvel yes must stop with an error (wall velocity added twice)
#   wallvel no must run (legacy tangential-only rotate keyword)
# usage: mpirun -np 4 spa_mpi -in in.guard_rotate -var wallvel yes|no

seed                12345
dimension           2
global              gridcut 0.0 comm/sort yes

boundary            r r p

create_box          0 10 0 10 -0.5 0.5
create_grid         20 20 1
balance_grid        rcb cell

global              nrho 1.0 fnum 0.01

species             air.species N O
mixture             air N O vstream 0.0 0.0 0.0 temp 300.0

read_surf           data.circle origin 5 5 0 scale 0.2 1.2 1

surf_collide        1 diffuse 300.0 1.0 rotate 5.0 5.0 0.0 0.0 0.0 31.4159
surf_modify         all collide 1

timestep            0.0001

create_particles    air n 10000

fix                 10 move/surf all 1 2000 rotate 360 0 0 1 5 5 0 &
                    engulf project wallvel ${wallvel}

run                 10
